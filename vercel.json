{
  "cleanUrls": true,
  "redirects": [
    { "source": "/templates/about-page", "destination": "/about", "permanent": true },
    { "source": "/templates/services-page", "destination": "/services", "permanent": true },
    { "source": "/templates/portfolio-page", "destination": "/portfolio", "permanent": true },
    { "source": "/templates/contact-us-page", "destination": "/contact", "permanent": true },
    { "source": "/templates/sub-pages/:subpage", "destination": "/:subpage", "permanent": true },
    { "source": "/sub-pages/:subpage", "destination": "/:subpage", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/:match*", "destination": "/api/:match*" },
    { "source": "/about", "destination": "/templates/about-page.html" },
    { "source": "/services", "destination": "/templates/services-page.html" },
    { "source": "/portfolio", "destination": "/templates/portfolio-page.html" },
    { "source": "/contact", "destination": "/templates/contact-us-page.html" },
    { "source": "/:subpage", "destination": "/templates/sub-pages/:subpage.html" }
  ]
}